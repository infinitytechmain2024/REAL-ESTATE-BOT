# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Environment
.env
.env.local
*.env
!.env.example

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime
*.log
# Anchored: an unanchored `data/` also matches searxng/searx/data/, which is
# part of the vendored SearXNG snapshot and must be committed. This rule is
# only meant for the bot's own runtime directory at the repo root (the
# Facebook profile and the gate token live there).
/data/

# Browser profiles and debug artefacts — these hold live session cookies
# and screenshots of group members, and must never reach the repo.
chrome-profile/
fb-bot-profile/
**/Default/
**/Local State
**/Cookies
screenshots/
*.png
