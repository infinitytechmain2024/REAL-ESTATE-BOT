# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# Environment. `*.env` matches a file ENDING in .env, which is not the shape
# a backup takes: `.env.backup` reached the repository through that gap, with
# live values in it. `.env.*` closes it, and the example is let back in.
.env
.env.local
*.env
.env.*
!.env.example

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime
*.log
# Anchored to the repository root on purpose. An unanchored `data/` matches a
# directory of that name at ANY depth, which silently swallowed the vendored
# legacy/searxng/searx/data package -- SearXNG cannot import without it, so the whole
# search engine was missing from every clone. See legacy/tests/test_deployment_legacy.py.
# This rule is only meant for the bot's own runtime directory at the repo root
# (the Facebook profile and the gate token live there).
/data/

# Browser profiles and debug artefacts — these hold live session cookies
# and screenshots of group members, and must never reach the repo.
chrome-profile/
fb-bot-profile/
**/Default/
**/Local State
**/Cookies
screenshots/
*.png
