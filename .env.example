# =============================================================================
# REAL-ESTATE-BOT configuration
#
# Copy to .env and fill in. Only TELEGRAM_TOKEN and one LLM provider are
# strictly required; everything else has a working default.
#
#   cp .env.example .env
#
# Lists accept either "a,b,c" or ["a","b","c"].
# =============================================================================

# --- general -----------------------------------------------------------------
ENVIRONMENT=local              # local | docker | render
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console for humans, json for Render


# =============================================================================
# Telegram
# =============================================================================
TELEGRAM_TOKEN=123456789:AAExampleTokenFromBotFather

TELEGRAM_MODE=polling          # polling (default) | webhook

# Webhook mode only. TELEGRAM_WEBHOOK_URL is the service's public https URL;
# the bot appends TELEGRAM_WEBHOOK_PATH to it when registering.
# TELEGRAM_WEBHOOK_URL=https://real-estate-bot.onrender.com
# TELEGRAM_WEBHOOK_PATH=/webhook
# TELEGRAM_WEBHOOK_SECRET=some-long-random-string
# TELEGRAM_WEBHOOK_HOST=0.0.0.0
# TELEGRAM_WEBHOOK_PORT=8080

# One request costs several LLM calls and up to a dozen page fetches, so both
# a global cap and a per-user cooldown are applied.
TELEGRAM_MAX_CONCURRENT_SEARCHES=3
TELEGRAM_REQUEST_COOLDOWN_SECONDS=3


# =============================================================================
# LLM
#
# LLM_PROVIDER picks the backend. Every provider below is already implemented;
# uncomment ONE block. Adding another one is a subclass plus a @register_llm
# line -- see bot/services/llm/.
#
# Registered names:
#   openai_compatible, openai, openrouter, groq, together, fireworks,
#   anthropic (alias: claude), nvidia (alias: nim)
# =============================================================================
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

# Optional split: a cheap model parses the request, a stronger one ranks and
# summarises the pages. Both fall back to LLM_MODEL.
# LLM_MODEL_EXTRACT=openai/gpt-4o-mini
# LLM_MODEL_RANK=anthropic/claude-sonnet-4.5

# Tried in order if the primary provider errors out. A provider whose key is
# not configured is skipped rather than treated as a failure.
# LLM_FALLBACK_PROVIDERS=anthropic,groq

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- OpenRouter (recommended: one key, most models) --------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# LLM_BASE_URL is optional here; the provider knows its own endpoint.

# --- Groq (fastest for open-weight models) -----------------------------------
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# --- Together ----------------------------------------------------------------
# LLM_PROVIDER=together
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# TOGETHER_API_KEY=...

# --- Fireworks ---------------------------------------------------------------
# LLM_PROVIDER=fireworks
# LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# FIREWORKS_API_KEY=fw_...

# --- Anthropic (Claude) ------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI ------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- NVIDIA (NIM / NGC catalogue) --------------------------------------------
# Hosted endpoints speak the OpenAI protocol, so nothing else changes.
# LLM_PROVIDER=nvidia
# LLM_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_API_KEY=nvapi-...
# For a self-hosted NIM container, point at it instead:
# LLM_BASE_URL=http://nim-container:8000/v1

# --- Any other OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, ...) -----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=not-needed-but-must-be-set


# =============================================================================
# Speech-to-text (voice messages)
#
# Registered names: openai_whisper (alias: openai), groq_whisper (alias: groq),
# nvidia (alias: riva). Set STT_ENABLED=false to politely refuse voice notes.
# =============================================================================
STT_ENABLED=true
STT_PROVIDER=groq_whisper
STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY=...            # falls back to GROQ_API_KEY / OPENAI_API_KEY etc.
# STT_LANGUAGE=ru            # leave empty to auto-detect
STT_TIMEOUT_SECONDS=120
STT_MAX_AUDIO_MB=20
# STT_FALLBACK_PROVIDERS=openai_whisper

# --- OpenAI Whisper ----------------------------------------------------------
# STT_PROVIDER=openai_whisper
# STT_MODEL=whisper-1        # or gpt-4o-transcribe
# OPENAI_API_KEY=sk-...

# --- NVIDIA ASR (NIM) --------------------------------------------------------
# STT_PROVIDER=nvidia
# STT_MODEL=nvidia/parakeet-ctc-1.1b-asr
# NVIDIA_API_KEY=nvapi-...

# --- Self-hosted (faster-whisper-server, ...) --------------------------------
# STT_PROVIDER=openai_whisper
# STT_BASE_URL=http://localhost:8000/v1
# STT_MODEL=Systran/faster-whisper-large-v3


# =============================================================================
# SearXNG
#
# In the single-container setup SearXNG listens on loopback inside the same
# container, so the default below is correct for both Docker and Render.
# =============================================================================
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_TIMEOUT_SECONDS=25
SEARXNG_MAX_RETRIES=2

# Must also be enabled in searxng/settings/settings.yml.
SEARXNG_ENGINES=google,bing,duckduckgo,brave,startpage

SEARXNG_MAX_QUERIES=6          # search strings per user request
SEARXNG_RESULTS_PER_QUERY=15
SEARXNG_MAX_HITS=40            # cap after merging and de-duplicating
SEARXNG_CONCURRENCY=4

SEARXNG_BLOCKED_DOMAINS=facebook.com,instagram.com,x.com,twitter.com,tiktok.com,pinterest.com,youtube.com,reddit.com

# Read by SearXNG itself, not by the bot:
# SEARXNG_SECRET=generate-a-long-random-string
# SEARXNG_BIND_ADDRESS=127.0.0.1
# SEARXNG_PORT=8888
# SEARXNG_VALKEY_URL=valkey://valkey:6379/0     # optional result cache


# =============================================================================
# Page fetching
# =============================================================================
PARSER_ENABLED=true            # false ranks on search snippets alone
PARSER_MAX_PAGES=8             # how many hits are actually downloaded
PARSER_CONCURRENCY=5
PARSER_TIMEOUT_SECONDS=15
PARSER_MAX_BYTES=1500000
PARSER_MAX_CHARS=6000          # page text handed to the LLM per candidate


# =============================================================================
# Supabase
#
# Optional. Without it the bot still searches and answers, but nothing is
# stored, results are not de-duplicated across sessions, and the buttons under
# each result are hidden -- there would be nothing to record a press against.
#
# Apply bot/services/db/migrations/001_init.sql first.
# Use the service_role key: the schema has RLS on with no permissive policies.
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
# SUPABASE_SCHEMA=public
# SUPABASE_TIMEOUT_SECONDS=20


# =============================================================================
# Pipeline behaviour
# =============================================================================
PIPELINE_MAX_RESULTS_TO_USER=8
PIPELINE_MIN_SCORE=45          # drop results the LLM scored lower
PIPELINE_SEND_DELAY_SECONDS=0.4
PIPELINE_SKIP_SEEN_RESULTS=true
