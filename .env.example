# =============================================================================
# REAL-ESTATE-BOT configuration
#
# Copy to .env and fill in. Only TELEGRAM_TOKEN and one LLM provider are
# strictly required; everything else has a working default.
#
#   cp .env.example .env
#
# Lists accept either "a,b,c" or ["a","b","c"].
# =============================================================================

# =============================================================================
# VPS Docker foundation
#
# These values configure docker-compose.yml. Use distinct, long random values
# in production: `openssl rand -base64 32`. PostgreSQL and Redis are internal
# Docker-only services; the application will eventually use the two URLs below.
# =============================================================================
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring_app
POSTGRES_PASSWORD=change-this-to-a-long-random-postgres-password
DATABASE_URL=postgresql://monitoring_app:change-this-to-a-long-random-postgres-password@postgres:5432/monitoring
REDIS_PASSWORD=change-this-to-a-long-random-redis-password
REDIS_URL=redis://:change-this-to-a-long-random-redis-password@redis:6379/0
CADDY_HTTP_PORT=8080

# --- general -----------------------------------------------------------------
ENVIRONMENT=local              # local | docker | render
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console for humans, json for Render


# =============================================================================
# Telegram
# =============================================================================
TELEGRAM_TOKEN=123456789:AAExampleTokenFromBotFather

# The control plane is open for reading: every Telegram user and chat can send
# text or voice messages and use /status and /help. Only the Telegram user IDs
# below may /run, /pause, /resume, /cancel, or confirm; each change still needs
# a one-time confirmation. Empty means nobody can change state. Send /run to
# the bot to see your own user ID. Comma-separated, e.g. 123456789,987654321
# Owners: full access, and the only ones who approve others. Anyone else can
# press "Request access" in the bot; owners approve them as a helper
# (verification only) or an operator (also controls collection). Approved
# people are stored in the database, not here. Send /operators to list them.
TELEGRAM_OPERATOR_IDS=
TELEGRAM_CONFIRMATION_TTL_SECONDS=300
# Auto mode (docs/CAMPAIGNS.md): when on, /campaign, /run, /pause and /resume
# from auto-operators skip the confirm step, and plain text or voice becomes a
# campaign goal. /cancel, /login, verification and owner admin stay manual;
# quotas and breakers still apply. on|off, default off. Owners switch it at
# runtime with /auto on|off (stored in the database, which then wins).
AUTO_MODE=off
# Auto-operators besides the owners: numeric IDs of approved *operators*
# (helpers and strangers are never eligible). Comma-separated.
TELEGRAM_AUTO_OPERATOR_IDS=
TELEGRAM_MAX_VOICE_MB=20

# Main Orchestra turns confirmed Telegram requests into audited, bounded
# database plans. It never shells out or starts a browser itself.
ORCHESTRA_COMMAND_LEASE_SECONDS=30
ORCHESTRA_POLL_SECONDS=1
# A running Facebook batch with no progress for this long is failed and its
# browser profile returned to ready (the collector died). Minimum 300.
ORCHESTRA_STALE_BATCH_SECONDS=900
# Safety: /run is refused over these daily quotas (rolling 24 h), and a
# platform/method "breaker" opens after this many challenges or failed runs
# (failures since the last success) within SAFETY_BREAKER_WINDOW_HOURS.
SAFETY_MAX_FACEBOOK_BATCHES_PER_DAY=6
SAFETY_MAX_FACEBOOK_GROUPS_PER_DAY=60
SAFETY_MAX_RUNS_PER_DAY=40
SAFETY_BREAKER_FAILURES=3
SAFETY_BREAKER_CHALLENGES=2
SAFETY_BREAKER_WINDOW_HOURS=6

# Campaign runner (/campaign <goal>): discovery, then windows of at most 20
# groups as ordinary Facebook batches under the same SAFETY_* limits. Status
# and findings go to the chat the campaign was started from.
CAMPAIGN_POLL_SECONDS=10
# Pause between two windows of one campaign (minimum 30).
CAMPAIGN_WINDOW_COOLDOWN_SECONDS=120
# After the last window, wait at most this long for analysis before completing.
CAMPAIGN_ANALYSIS_GRACE_SECONDS=600
# A window refused by a quota or breaker is retried after this long.
CAMPAIGN_REFUSAL_RETRY_SECONDS=300

# Website stage of campaigns (docs/WEB_SEARCH.md), in parallel with Facebook:
# AI search queries (OPENROUTER_API_KEY; templates without it) -> the internal
# `searxng` service -> public listing pages -> the same analysis and cards.
# Every URL and site is remembered: a listing is read once; an index page is
# re-read after WEB_SEARCH_INDEX_TTL_DAYS.
WEB_SEARCH_ENABLED=true
# Search backends, comma list: searxng | google_cse | serpapi (several are queried together and merged).
# Google CSE: 100 free queries/day, then paid. SerpAPI: paid. A backend without its key is skipped.
WEB_SEARCH_BACKENDS=searxng
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=
WEB_SEARCH_GOOGLE_CSE_DAILY_CAP=90
WEB_SEARCH_SERPAPI_DAILY_CAP=90
OPENROUTER_WEB_QUERY_MODEL=openai/gpt-4o-mini
# The search plan of a campaign (portals, queries per language, direct portal search URLs; docs/WEB_SEARCH.md):
# one call per campaign, so the best model is worth it. Recommended: anthropic/claude-opus-5.5
# (default: anthropic/claude-sonnet-4.5). No key or a failed call: the queries below are used as before.
OPENROUTER_PLAN_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_PLAN_TIMEOUT_SECONDS=45
CAMPAIGN_SEARCH_PLAN_ENABLED=true
# Queries are generated in rounds, never repeated, up to the per-campaign cap.
WEB_SEARCH_QUERIES_PER_ROUND=12
WEB_SEARCH_MAX_QUERIES_PER_CAMPAIGN=80
# Results kept per query, and how many SearXNG result pages (pageno 1..N, 1-5) are
# walked for it; the walk stops early when a page brings nothing new.
WEB_SEARCH_RESULTS_PER_QUERY=30
WEB_SEARCH_PAGES_PER_QUERY=2
# Hours another campaign's search of the same query blocks it (0: never; a campaign
# never repeats its own queries). An index (portal search/list) page is read again
# after this many days (0: never); its listing links are de-duplicated as usual.
WEB_SEARCH_QUERY_REUSE_HOURS=0
WEB_SEARCH_INDEX_TTL_DAYS=7
# Pages read per campaign, per site per campaign, and links taken from one
# portal search page. 20 portals are searched: small caps cut Fotocasa off after
# one search page and ended campaigns before the portals were read.
WEB_SEARCH_MAX_PAGES_PER_CAMPAIGN=400
WEB_SEARCH_MAX_PAGES_PER_HOST=100
WEB_SEARCH_MAX_PAGES_PER_UNKNOWN_HOST=5
WEB_SEARCH_MAX_LINKS_PER_INDEX=40
# Whole system, rolling 24 h; a campaign's web stage ends when either is hit.
WEB_SEARCH_MAX_PAGES_PER_DAY=3000
WEB_SEARCH_MAX_QUERIES_PER_DAY=300
WEB_SEARCH_MAX_MINUTES_PER_CAMPAIGN=240
# At least this long between two requests to one site (robots.txt Crawl-delay wins if longer).
WEB_SEARCH_HOST_INTERVAL_SECONDS=5
# Extra sites never read (comma-separated hosts); social networks are always skipped.
WEB_SEARCH_BLOCKED_HOSTS=
# Search every known portal of the country with its own site: query (Spain: Idealista and
# Fotocasa first; for land Terrenos.es and Sareb right after them; then Yaencontre, Pisos.com, Habitaclia, Milanuncios ... Sareb, Green-Acres),
# besides the sites the model picks. The not-yet-searched ones take up to half of each round.
WEB_SEARCH_COVER_PORTALS=true
# Which sites a search hit may come from. strict: only the country's known portals (Spain: the 20 of
# bot/web_search/urls.py SPAIN_PORTALS) plus the sites the plan or the person named; soft: also other sites whose hit
# shows a price or an area; off: also any hit with a property word and a deal word (dictionaries got through that way).
WEB_SEARCH_DOMAIN_POLICY=strict
# A site refused (403/429/captcha on every layer tried) this many pages in a row is skipped for the rest of the
# campaign -- no browser, no paid unlocker; its search results stay as cards. 0: off.
WEB_SEARCH_HOST_BREAKER_REFUSALS=3
# USD per paid search query (Google CSE / SerpAPI; SearXNG is free), booked against CAMPAIGN_BUDGET_USD.
WEB_SEARCH_PAID_QUERY_COST_USD=0
# Scrapling reads each page's own JSON-LD (price, currency, area, rooms, address)
# and puts it on top of the post for the analysis. A page the site served but
# drew with JavaScript (no text, or a result list without links) is read once
# more in the `browser` service (the Agent Reach path; a separate profile, no
# login). A refused page (403/429/503, a captcha page) is tried once there too; robots.txt is never bypassed.
WEB_SEARCH_RENDER_ENABLED=true
WEB_SEARCH_RENDER_TIMEOUT_SECONDS=30
# Counted in the database (web_campaign_urls.rendered), so a restart does not reset it.
WEB_SEARCH_MAX_RENDERS_PER_CAMPAIGN=60
# A page the plain fetch was refused (403/429/503, a captcha page) is read once in the browser too
# (robots.txt still decides first). If that is refused as well: the search-result card.
WEB_SEARCH_RENDER_ON_REFUSAL=true
# A refused depth-0 index (search/list) page may use the browser; the scrape API is never used for index pages.
WEB_SEARCH_RENDER_INDEX_ON_REFUSAL=true
# Human verification of websites: when the browser lands on a CAPTCHA / anti-bot page, a verification job is opened
# (the same Telegram button and live browser as the Facebook checks); a person passes the check by hand and presses
# «Готово». Meanwhile the site is skipped; afterwards its queued pages are read through the same browser profile,
# gently. Nothing is solved or worked around automatically. WARNING: a site's terms of use may forbid automated
# access, even after a person passed its check; turn this on only as the owner's explicit decision. Off by default.
# Unsolved jobs expire after VERIFICATION_JOB_HOURS (that site is then unreadable for the campaign).
WEB_SEARCH_HUMAN_VERIFICATION=off
WEB_SEARCH_VERIFIED_HOST_INTERVAL_SECONDS=8
WEB_SEARCH_PAGES_PER_VERIFICATION=40
# Optional last layer for pages HTTP and the browser were both refused: a scrape/unlocker API called as
# GET <url>?url=<page> with "Authorization: Bearer <key>". Empty: off. Counted in the database per campaign.
# May point to any host the owner trusts (no address check is made on it).
WEB_SEARCH_SCRAPE_API_URL=
WEB_SEARCH_SCRAPE_API_KEY=
WEB_SEARCH_MAX_SCRAPE_API_PER_CAMPAIGN=40
# USD per scrape-API call (booked per call, refused ones too), against CAMPAIGN_BUDGET_USD. 0: not counted.
WEB_SEARCH_SCRAPE_API_COST_USD=0
# Optional outbound proxy/VPN for page reads and SearXNG (http://host:port or
# socks5://host:port), e.g. http://gluetun:8888 with the gluetun snippet in
# docker-compose.yml. Empty: direct. A comma-separated list rotates per site: each
# host sticks to one proxy, the next is used only if it cannot connect.
WEB_SEARCH_PROXY_URL=
# Page reads look like a real browser (curl_cffi TLS/HTTP2 fingerprint + headers):
# off | chrome | safari | firefox | an explicit profile such as chrome124. "off" or a
# missing curl_cffi uses plain httpx with the declared bot user agent.
WEB_SEARCH_IMPERSONATE=chrome
# WEB_SEARCH_BROWSER_USER_AGENT=
# SearXNG's own secret; empty makes a random one at each start (fine: it is internal).
SEARXNG_SECRET=

# Social network search (bot/social_search), in parallel with Facebook: the
# campaign runner opens TikTok / Instagram / LinkedIn with the profile logged
# in through /login <platform> (or Settings -> «🔐 Вход в соцсети») and uses
# the network's own search with AI queries (OPENROUTER_API_KEY; without it,
# deterministic queries from the plan). A network is searched only once its
# profile is logged in; `off` turns the stage off. A login wall, captcha or
# checkpoint stops the platform and asks the owner to log in again; the bot
# never types credentials. Automated use may break the networks' terms and
# can get an account restricted: use a dedicated account and low caps.
SOCIAL_SEARCH_PLATFORMS=instagram,tiktok,linkedin
# Strict caps per platform (all campaigns together) and pacing.
SOCIAL_SEARCH_QUERIES_PER_DAY=20
SOCIAL_SEARCH_ITEMS_PER_QUERY=12
SOCIAL_SEARCH_QUERIES_PER_ROUND=4
SOCIAL_SEARCH_MAX_ROUNDS=3
# Pause between two queries on one platform, plus random jitter up to the second value.
SOCIAL_SEARCH_PAUSE_SECONDS=120
SOCIAL_SEARCH_JITTER_SECONDS=90
# Instagram grid tiles have no caption: at most this many post pages are opened per query.
SOCIAL_SEARCH_OPEN_POSTS_PER_QUERY=4
SOCIAL_SEARCH_SCROLLS=2
# A query another campaign ran within this many days is not repeated.
SOCIAL_SEARCH_QUERY_REUSE_DAYS=7
SOCIAL_SEARCH_RATE_LIMIT_COOLDOWN_HOURS=6
SOCIAL_SEARCH_POLL_SECONDS=15
# After the last Facebook window, wait at most this long for remaining social queries.
CAMPAIGN_SOCIAL_GRACE_SECONDS=1800
OPENROUTER_SOCIAL_MODEL=openai/gpt-4o-mini
# Each campaign finding is checked against the task by one small AI call (stored once);
# at most this many calls per campaign. Past the cap, after a failure or without a key an exact
# finding is held as «similar» (not sent unasked) while CAMPAIGN_RELEVANCE_FAIL_CLOSED=true; false: sent as before.
OPENROUTER_MATCH_MODEL=openai/gpt-4o-mini
OPENROUTER_MATCH_TIMEOUT_SECONDS=15
CAMPAIGN_RELEVANCE_MAX_CALLS=2000
CAMPAIGN_RELEVANCE_FAIL_CLOSED=true
# Who judges each finding against the task: reviewer (default; a strong model checks every hard criterion of the
# task: place, deal, type, budget, rooms, area, must-haves, exclusions, pass/fail/unknown with a quote each;
# a hard fail is rejected, an unknown is held as «similar», only all-pass is sent) or legacy (the one-word
# gpt-4o-mini judge above). The reviewer replaces that call; the caps and fail-closed rules above stay.
# Recommended review model: anthropic/claude-opus-4.5 (more accurate, costlier per finding).
CAMPAIGN_JUDGE=reviewer
OPENROUTER_REVIEW_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_REVIEW_TIMEOUT_SECONDS=45
# Cost cap of the reviewer: at most this many review calls per campaign, counted as ATTEMPTS (failed calls count too);
# past it a finding is held as «similar, not verified» instead of sent.
CAMPAIGN_REVIEW_MAX_CALLS=300
# The final report to the person who asked, once when a search ends (counts by reason, the ten best cards,
# per-site funnel, sites that could not be read, 2-4 recommendations written from the aggregated numbers only).
# Recommended final model: anthropic/claude-opus-4.5. Without OPENROUTER_API_KEY the recommendations are rule-based.
CAMPAIGN_FINAL_REPORT=true
# The most one campaign may spend in USD: every LLM call (OpenRouter's own usage.cost), scrape-API page, paid search
# and listing-API run is booked in campaign_costs (migration 042) by every service. When it is reached the web stage
# stops (budget_cap), the analysis worker and the AI check skip the campaign's findings, and the final report shows
# the spend by stage, what was skipped before the model and the model's errors. 0: no limit.
CAMPAIGN_BUDGET_USD=5
OPENROUTER_FINAL_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_FINAL_TIMEOUT_SECONDS=60
# Investor leads from comments (bot/campaign/leads.py): each Facebook object a campaign sends is
# queued for one read of its comments (all | investors | off; investors: only investor searches read
# comments, the default, so a plain property search does not spend Facebook reads on them). The people interested as buyers or
# investors are only stored; an investor search in the same city sends them (at most
# CAMPAIGN_LEAD_PEOPLE_MAX, seen in the last CAMPAIGN_LEAD_DAYS days). Comment reads run only while
# Facebook is otherwise idle and have their own daily cap.
CAMPAIGN_COMMENT_LEADS=investors
CAMPAIGN_COMMENT_MAX_POSTS=15
SAFETY_MAX_FACEBOOK_COMMENT_READS_PER_DAY=40
CAMPAIGN_COMMENT_READS_PER_ROUND=3
CAMPAIGN_LEAD_PEOPLE_MAX=60
CAMPAIGN_LEAD_DAYS=90
OPENROUTER_LEADS_MODEL=openai/gpt-4o-mini
# A group whose newest post is this many days older than its last read is dead: skipped by every
# campaign until that read is 30 days old.
FACEBOOK_GROUP_DEAD_DAYS=7
# Investor reach (bot/campaign/reach.py): an investor search also asks the search engines platform by
# platform (site:linkedin.com/in, reddit, x.com, instagram, tiktok, youtube, the open web) for investors,
# agents, agencies, funds and investor networks in its city. Only the result list is read: no platform is
# opened and no account is used. Judged results are kept once and sent by investor searches of that city.
INVESTOR_REACH_ENABLED=true
INVESTOR_REACH_QUERIES_PER_CAMPAIGN=16
INVESTOR_REACH_QUERIES_PER_DAY=80
OPENROUTER_REACH_MODEL=openai/gpt-4o-mini
# The model writes this many queries from the task itself (who, where, which language); templates fill the rest.
INVESTOR_REACH_MODEL_QUERIES=10
# A relevant reach result's public page (a site or t.me/s/<channel>; never LinkedIn, Instagram, TikTok, X, Reddit)
# is opened once for e-mails, phones, website, company, description and last activity; at most this many per campaign.
INVESTOR_REACH_ENRICH_PER_CAMPAIGN=30

# =============================================================================
# Browser session manager
#
# The browser service is internal Docker-only. This token is mandatory for
# other services calling its acquire/release/screenshot API; it is not a user
# credential. Profiles and screenshots remain in private Docker volumes.
# =============================================================================
BROWSER_SESSION_API_TOKEN=replace-with-a-32-plus-character-random-secret

# --- Human verification flow ----------------------------------------------
# When a collector stops on a challenge, everyone in TELEGRAM_OPERATOR_IDS
# gets a Telegram button that opens the verification page (a Mini App at
# https://<LIVE_VIEW_DOMAIN>/verify/...): claim the job, solve it in the
# profile's own browser, mark Solved; a watchdog reloads the page and only a
# clean page lets the run resume. Identity checks, new 2FA and account
# restrictions go to the owner only. Uses LIVE_VIEW_PUBLIC_URL unless
# VERIFICATION_PUBLIC_URL is set.
# VERIFICATION_OWNER_TELEGRAM_ID=
VERIFICATION_TOKEN_MINUTES=15
VERIFICATION_SESSION_MINUTES=30
VERIFICATION_JOB_HOURS=24
VERIFICATION_RENOTIFY_MINUTES=30
VERIFICATION_LIVE_MINUTES=20

# --- Live browser for Facebook login and checkpoints ----------------------
# When a profile needs a human (/login, or Facebook shows a checkpoint), the
# bot messages every operator with an "Open browser" button. It opens a
# Telegram Mini App: Telegram signs the operator's identity, so only people in
# TELEGRAM_OPERATOR_IDS get the window, and a forwarded message opens nothing.
# The operator logs in or passes the check by hand, then presses Done.
#
# Needs a public HTTPS name for this VPS. No domain purchase is required:
# <your-ip-with-dashes>.sslip.io resolves to the IP, e.g. 203-0-113-7.sslip.io.
# Ports 80 and 443 must be reachable from the internet for the certificate.
# LIVE_VIEW_DOMAIN=203-0-113-7.sslip.io
# LIVE_VIEW_PUBLIC_URL=https://203-0-113-7.sslip.io
# Publish Caddy's ports 80/443; the default keeps them on loopback only.
# LIVE_VIEW_BIND=0.0.0.0
# How long an opened window stays open.
LIVE_VIEW_OPEN_MINUTES=20
# An unopened request lapses after this; a checkpoint is re-announced after it.
LIVE_VIEW_REQUEST_MINUTES=60
# How often the bot looks for profiles that need a human.
LIVE_VIEW_POLL_SECONDS=60
BROWSER_LEASE_SECONDS=120
BROWSER_LEASE_RENEW_SECONDS=30
# A session with no request for this long is closed and its profile freed, so
# a crashed collector cannot hold the browser forever. Minimum 60.
BROWSER_IDLE_SECONDS=300

# =============================================================================
# Dedicated Facebook batch collector
#
# Run by hand through the `collector` Compose profile with one queued batch
# UUID as FACEBOOK_BATCH_ID. The facebook-runner service restarts only batches
# that a verification Resume requeued. The database migration deliberately caps batches
# at 20 groups; every group is read in order, with no concurrent browser use.
# =============================================================================
# FACEBOOK_BATCH_ID=00000000-0000-0000-0000-000000000000
FACEBOOK_COLLECTOR_MAX_GROUPS=20
FACEBOOK_COLLECTOR_RUNNER_POLL_SECONDS=15
# Long-running workers (Agent Reach, Scrapling, analysis) check their queues this often.
AGENT_REACH_POLL_SECONDS=15
SCRAPLING_POLL_SECONDS=15
ANALYSIS_POLL_SECONDS=15
ANALYSIS_CLAIM_SECONDS=300
FACEBOOK_COLLECTOR_MAX_POSTS_PER_GROUP=15
# Per group, 35-600. Up to 60 s of it is page navigation; the rest lets the
# feed render. Keep ORCHESTRA_STALE_BATCH_SECONDS well above this plus a pause.
FACEBOOK_COLLECTOR_GROUP_TIMEOUT_SECONDS=90
FACEBOOK_COLLECTOR_PAUSE_MIN_SECONDS=4
FACEBOOK_COLLECTOR_PAUSE_MAX_SECONDS=9

# =============================================================================
# Controlled Agent Reach adapter
#
# This is a bounded, read-only adapter that uses the Browser Session Manager;
# it does NOT install, invoke, or grant shell access to upstream Agent Reach.
# The Main Orchestra sends a one-shot JSON task with explicit HTTPS targets.
# It may use only read_public_page and extract_public_text. No account writes,
# group joins, messages, profile edits, or target discovery are permitted.
# =============================================================================
AGENT_REACH_MAX_PAGES=5
AGENT_REACH_MAX_EXECUTION_SECONDS=120
AGENT_REACH_PAGE_TIMEOUT_SECONDS=30
AGENT_REACH_UPSTREAM_ENABLED=false
# AGENT_REACH_TASK_JSON={"task_id":"...","platform":"tiktok","targets":["https://www.tiktok.com/@example"],"browser_profile_id":"...","browser_profile_name":"tiktok-main"}

# =============================================================================
# Scrapling website connector
#
# HTTP-first, one explicit website URL per run. Scrapling parses the downloaded
# HTML only; no Scrapling fetcher, stealth mode, browser, spider, link
# following, or challenge bypass capability is enabled.
# =============================================================================
# SCRAPLING_RUN_ID=00000000-0000-0000-0000-000000000000
SCRAPLING_CONNECTOR_MAX_RUNTIME_SECONDS=45
SCRAPLING_CONNECTOR_REQUEST_TIMEOUT_SECONDS=20
SCRAPLING_CONNECTOR_MAX_CONTENT_BYTES=1500000
SCRAPLING_CONNECTOR_MAX_CONTENT_CHARS=120000
SCRAPLING_CONNECTOR_USER_AGENT=RealEstateResearchBot/0.1

# Telegram control-plane voice notes are transcribed by OpenRouter with the
# same OPENROUTER_API_KEY as the analysis pipeline (see the "Speech-to-text"
# section below for STT_PROVIDER/STT_MODEL/STT_TIMEOUT_SECONDS). One request
# per voice note, never retried; the returned cost is stored per message.
# 20 MiB is also Telegram's own limit for files a bot may download.
STT_MAX_AUDIO_BYTES=20971520
STT_MAX_AUDIO_SECONDS=300

# --- OpenRouter (recommended: one key, most models) --------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# Hybrid pipeline, Reduction agents (docs/HYBRID_AGENTS.md), shadow mode: each
# campaign post -> Claude extraction -> Jev decision -> gate, stored in
# agent_reductions, nothing sent. Both models go through OPENROUTER_API_KEY and
# are checked against https://openrouter.ai/api/v1/models at start. Each post
# costs two model calls; the daily cap bounds the cost (0 = no calls).
AGENT_REDUCTION_ENABLED=false
# shadow: decisions only stored. live: the posts of AGENT_REDUCTION_SOURCES (comma-separated platforms) become
# ordinary findings the campaign runner streams; then also set ANALYSIS_EXCLUDE_PLATFORMS to the same list so the
# analysis worker leaves them alone (it keeps Facebook and the social networks).
AGENT_REDUCTION_MODE=shadow
AGENT_REDUCTION_SOURCES=website
ANALYSIS_EXCLUDE_PLATFORMS=
OPENROUTER_CLAUDE_MODEL=anthropic/claude-opus-5.5
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
AGENT_REDUCTION_CONCURRENCY=4
AGENT_REDUCTION_BATCH=5
AGENT_REDUCTION_MAX_CALLS_PER_DAY=1000
# Bounded structured analysis (bot/analysis_pipeline); never expose this key
# to a browser/client.
# Sonnet for structured extraction with verbatim quotes (analysis-v6); override with any OpenRouter model id.
OPENROUTER_ANALYSIS_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_ANALYSIS_TIMEOUT_SECONDS=60
# Telegram interviewer (grill-me): one call per user message; it asks one question at a time until the task
# is fully specified. Failures fall back to the built-in rules. A STRONG model asks noticeably better
# questions: e.g. anthropic/claude-opus-4.5 (the default below is cheaper and faster).
OPENROUTER_INTERVIEW_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_INTERVIEW_TIMEOUT_SECONDS=30
# After this many questions the interview ends and the card is shown anyway.
INTERVIEW_MAX_ROUNDS=14
# Legacy one-shot task reading: no longer used by intake, but still read by bot/control_plane/settings.py
# (kept until stage 6 removes it).
OPENROUTER_INTAKE_MODEL=openai/gpt-4o-mini
OPENROUTER_INTAKE_TIMEOUT_SECONDS=20
ANALYSIS_BATCH_SIZE=10
# Optional numeric recipient for idempotent findings digests. Leave blank to
# persist findings without Telegram delivery.
ANALYSIS_TELEGRAM_CHAT_ID=
# =============================================================================
# Speech-to-text (voice messages)
#
# Registered names: openrouter, openai_whisper (alias: openai), groq_whisper
# (alias: groq), nvidia (alias: riva). Set STT_ENABLED=false to politely refuse
# voice notes. The VPS Telegram control plane accepts only `openrouter`.
# =============================================================================
STT_ENABLED=true
STT_PROVIDER=openrouter
STT_MODEL=openai/whisper-large-v3-turbo
# STT_API_KEY=...            # falls back to OPENROUTER_API_KEY / GROQ_API_KEY etc.
# STT_LANGUAGE=ru            # leave empty to auto-detect
STT_TIMEOUT_SECONDS=60
STT_MAX_AUDIO_MB=20
# STT_FALLBACK_PROVIDERS=openai_whisper

# =============================================================================
# Supabase
#
# Reserved for a future Supabase integration. The Docker PostgreSQL service and
# its migrations remain the primary database today; the Telegram control plane
# does not read these variables or connect to Supabase.
#
# Do not put SUPABASE_SERVICE_ROLE_KEY in a client, browser bundle, logs, or
# committed .env file. It is for a future server-side integration only.
# =============================================================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-publishable-or-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# How long stored rows live. The results table holds page text and contact
# details belonging to people who never used the bot, so this is a policy
# choice rather than a tuning knob -- see COMPLIANCE.md. 0 keeps everything
# and logs a warning at start-up.
SUPABASE_RETENTION_DAYS=90
# SUPABASE_SCHEMA=public
# SUPABASE_TIMEOUT_SECONDS=20


# =============================================================================
# Legacy standalone bot (legacy/) -- NOT read by the campaign stack
#
# Everything below belonged to the retired single-process bot that now lives in
# legacy/ (see legacy/README.md). No docker-compose service reads these
# variables; they are kept so the legacy bot can be revived. SEARXNG_SECRET is
# the one exception: the compose `searxng` service takes it from here.
# =============================================================================

TELEGRAM_MODE=polling          # polling (default) | webhook

# Webhook mode only. TELEGRAM_WEBHOOK_URL is the service's public https URL;
# the bot appends TELEGRAM_WEBHOOK_PATH to it when registering.
# TELEGRAM_WEBHOOK_URL=https://real-estate-bot.onrender.com
# TELEGRAM_WEBHOOK_PATH=/webhook
# TELEGRAM_WEBHOOK_SECRET=some-long-random-string
# TELEGRAM_WEBHOOK_HOST=0.0.0.0
# TELEGRAM_WEBHOOK_PORT=8080

# One request costs several LLM calls and up to a dozen page fetches, so both
# a global cap and a per-user cooldown are applied.
TELEGRAM_MAX_CONCURRENT_SEARCHES=3
TELEGRAM_REQUEST_COOLDOWN_SECONDS=3


# =============================================================================
# LLM
#
# LLM_PROVIDER picks the backend. Every provider below is already implemented;
# uncomment ONE block. Adding another one is a subclass plus a @register_llm
# line -- see bot/services/llm/.
#
# Registered names:
#   openai_compatible, openai, openrouter, groq, together, fireworks,
#   anthropic (alias: claude), nvidia (alias: nim)
# =============================================================================
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini

# Optional split: a cheap model parses the request, a stronger one ranks, and
# a long-context model writes detailed briefings. All fall back to LLM_MODEL.
# LLM_MODEL_EXTRACT=openai/gpt-4o-mini
# LLM_MODEL_RANK=anthropic/claude-sonnet-4.5
# LLM_MODEL_FAST=qwen3:8b
# LLM_MODEL_STRONG=qwen3:14b
# LLM_MODEL_LONG=mistral-small3.2:24b

# Tried in order if the primary provider errors out. A provider whose key is
# not configured is skipped rather than treated as a failure.
# LLM_FALLBACK_PROVIDERS=anthropic,groq

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# LLM_BASE_URL is optional here; the provider knows its own endpoint.

# --- A model on this machine (llama.cpp) -------------------------------------
# `make llm` starts it. Nothing leaves the machine, which is the point when the
# text being judged is Facebook posts carrying people's names and phone numbers.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=local

# --- Groq (fastest for open-weight models) -----------------------------------
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# --- Together ----------------------------------------------------------------
# LLM_PROVIDER=together
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# TOGETHER_API_KEY=...

# --- Fireworks ---------------------------------------------------------------
# LLM_PROVIDER=fireworks
# LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# FIREWORKS_API_KEY=fw_...

# --- Anthropic (Claude) ------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI ------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- NVIDIA (NIM / NGC catalogue) --------------------------------------------
# Hosted endpoints speak the OpenAI protocol, so nothing else changes.
# LLM_PROVIDER=nvidia
# LLM_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_API_KEY=nvapi-...
# For a self-hosted NIM container, point at it instead:
# LLM_BASE_URL=http://nim-container:8000/v1

# --- Any other OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, ...) -----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# LLM_MODEL_FAST=qwen3:8b
# LLM_MODEL_STRONG=qwen3:14b
# LLM_MODEL_LONG=mistral-small3.2:24b

# --- Groq Whisper ------------------------------------------------------------
# STT_PROVIDER=groq_whisper
# STT_MODEL=whisper-large-v3-turbo
# GROQ_API_KEY=gsk_...

# --- OpenAI Whisper ----------------------------------------------------------
# STT_PROVIDER=openai_whisper
# STT_MODEL=whisper-1        # or gpt-4o-transcribe
# OPENAI_API_KEY=sk-...

# --- NVIDIA ASR (NIM) --------------------------------------------------------
# STT_PROVIDER=nvidia
# STT_MODEL=nvidia/parakeet-ctc-1.1b-asr
# NVIDIA_API_KEY=nvapi-...

# --- Self-hosted (faster-whisper-server, ...) --------------------------------
# STT_PROVIDER=openai_whisper
# STT_BASE_URL=http://localhost:8000/v1
# STT_MODEL=Systran/faster-whisper-large-v3

# =============================================================================
# SearXNG
#
# In the single-container setup SearXNG listens on loopback inside the same
# container, so the default below is correct for both Docker and Render.
# =============================================================================
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_TIMEOUT_SECONDS=25
SEARXNG_MAX_RETRIES=2

# Must also be enabled in searxng/settings/settings.yml.
SEARXNG_ENGINES=google,bing,duckduckgo,brave,startpage

SEARXNG_MAX_QUERIES=6          # search strings per user request
# Always searched, whatever language the request arrived in and whatever the
# Facebook account's interface is set to. The same plot is advertised by a
# Spanish seller, discussed in a Russian-speaking group and listed in English
# on a portal -- searching one of those finds one slice of it.
SEARXNG_LANGUAGES=en,es,ru
# Upper bound per request. The list above is always covered even if this is
# lower; raise it to leave room for a local language the request implies but
# the list does not carry -- Greek for Cyprus, say.
SEARXNG_MAX_LANGUAGES=3
SEARXNG_RESULTS_PER_QUERY=15
SEARXNG_MAX_HITS=40            # cap after merging and de-duplicating
SEARXNG_CONCURRENCY=4

SEARXNG_BLOCKED_DOMAINS=facebook.com,instagram.com,x.com,twitter.com,tiktok.com,pinterest.com,youtube.com,reddit.com

# Read by SearXNG itself, not by the bot:
# SEARXNG_SECRET=generate-a-long-random-string
# SEARXNG_BIND_ADDRESS=127.0.0.1
# SEARXNG_PORT=8888
# SEARXNG_VALKEY_URL=valkey://valkey:6379/0     # optional result cache


# =============================================================================
# Page fetching
# =============================================================================
PARSER_ENABLED=true            # false ranks on search snippets alone
PARSER_SCRAPLING_ENABLED=true  # adaptive HTTP fallback for changed listing pages
PARSER_MAX_PAGES=8             # how many hits are actually downloaded
PARSER_CONCURRENCY=5
PARSER_TIMEOUT_SECONDS=15
PARSER_MAX_BYTES=1500000
PARSER_MAX_CHARS=6000          # page text handed to the LLM per candidate

# --- Browser fallback (optional) ---------------------------------------------
# Large listing portals (Idealista and friends) answer a plain HTTP client with
# 403 however polite its headers are. With this on, such pages are retried in
# headless Chromium; pages that merely 404 are not.
#
# Playwright is already in requirements.txt (the Facebook module needs it),
# but the browser binary is a separate download:
#   playwright install chromium
# The bot refuses to start if this is true without it.
PARSER_BROWSER_ENABLED=false

# Domains fetched in the browser directly, skipping the doomed HTTP attempt.
# Subdomains are covered, so `idealista.com` also matches `www.idealista.com`.
# PARSER_BROWSER_DOMAINS=idealista.com,idealista.es,fotocasa.es,habitaclia.com

# Egress proxy for the browser only. A residential/mobile endpoint matters more
# than anything else here: a datacenter IP is the main signal these protections
# act on, so the browser on a bare VPS IP buys much less than it looks like.
# PARSER_BROWSER_PROXY_URL=http://user:pass@proxy.example.com:8000

# URLs for scripts/portal_probe.py, which reports which of these need the
# browser and whether what comes back is usable. Comma separated.
# PARSER_PROBE_URLS=https://www.idealista.com/...,https://www.fotocasa.es/...

# PARSER_BROWSER_CONCURRENCY=2       # real page renders; keep it small
# PARSER_BROWSER_TIMEOUT_SECONDS=30
# PARSER_BROWSER_WAIT_UNTIL=domcontentloaded   # load | domcontentloaded | networkidle | commit
# PARSER_BROWSER_LOCALE=es-ES
# PARSER_BROWSER_HEADLESS=true

# --- Google Maps Scraper Kit (optional local sidecar) ----------------------
# Start the kit in its own directory with: docker compose up -d
# Coordinates are required by its API; keep jobs small and infrequent.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_BASE_URL=http://127.0.0.1:8080
# GOOGLE_MAPS_LATITUDE=40.4168
# GOOGLE_MAPS_LONGITUDE=-3.7038
GOOGLE_MAPS_RADIUS_METERS=10000
GOOGLE_MAPS_DEPTH=5
GOOGLE_MAPS_MAX_RESULTS=30
GOOGLE_MAPS_EXTRACT_EMAILS=false  # slower website crawl; phones/sites are returned without it

# =============================================================================
# Pipeline behaviour
# =============================================================================
PIPELINE_MAX_RESULTS_TO_USER=8
# Candidates judged by the ranking model in one call. Reading a whole group
# can produce hundreds of posts; they are ordered by a local, deterministic
# score first, and this many go into the prompt.
PIPELINE_MAX_CANDIDATES_TO_RANK=60
PIPELINE_MIN_SCORE=45          # drop results the LLM scored lower
PIPELINE_SEND_DELAY_SECONDS=0.4
PIPELINE_SKIP_SEEN_RESULTS=true
PIPELINE_SOURCE_TIMEOUT_SECONDS=900     # a wedged extra source is dropped, not waited on


# =============================================================================
# Facebook groups (optional, off by default)
#
# One shared, visible browser session reads configured groups. End users
# never log in to Facebook themselves. Log in by hand once -- either directly
# in the browser window (local dev) or through the Telegram "Open Facebook"
# button (VM/production, see below) -- the profile on disk keeps the session
# after that. Not wired into the live bot's group-reading yet; see
# bot/services/facebook/ and scripts/facebook_probe.py.
#
# 2FA should be turned OFF on the account this bot uses (in Facebook's own
# Accounts Center -> Password and security -> Two-factor authentication).
# That removes the "enter this code" prompt from the login flow entirely.
# It does NOT remove Facebook's separate checkpoint/CAPTCHA challenge, which
# can still appear on an unfamiliar device or IP regardless of the 2FA
# setting -- that is what the human-takeover flow below is for, and there is
# no setting that removes it; automating past it is out of scope, full stop.
# =============================================================================
FACEBOOK_ENABLED=false
FACEBOOK_PROFILE_DIR=./data/facebook_profile
FACEBOOK_HEADLESS=false                 # keep visible so a human can take over
# FACEBOOK_GROUP_URLS=https://www.facebook.com/groups/example1,https://www.facebook.com/groups/example2
# 0 = every post the group's feed will give up. What ends the read is then
# FACEBOOK_GROUP_READ_SECONDS and the feed running out of new posts.
FACEBOOK_MAX_POSTS_PER_GROUP=0
# The Facebook browser is shared and single-threaded: without a budget,
# one busy group holds every other search behind it.
FACEBOOK_GROUP_READ_SECONDS=180
FACEBOOK_MAX_SEARCH_TERMS=6
FACEBOOK_GROUP_ACTIVITY_DAYS=30
FACEBOOK_GROUP_STORE_PATH=./data/facebook_groups.sqlite3
FACEBOOK_AUTO_JOIN_GROUPS=true
# Localized phrases tried per group, for the same reason as above. Each one
# is a full in-group search through the single shared browser, so this buys
# coverage with time rather than with money.
FACEBOOK_MAX_SEARCH_TERMS=3
FACEBOOK_MAX_COMMENTS_PER_POST=15
FACEBOOK_MIN_GROUP_RECHECK_MINUTES=60
# FACEBOOK_LOGIN_EMAIL=
# FACEBOOK_LOGIN_PASSWORD=              # only the one automatic attempt; never logged
# FACEBOOK_ADMIN_TELEGRAM_IDS=123456789

# --- Local dev vs. VM/production: how the bot gets its browser -------------
#
# Local (no CDP_URL set): the bot launches and owns its own Chrome window via
# Playwright. Just run `python -m bot.main` and log in in the window that
# opens. Nothing below this point is needed.
#
# VM/production (CDP_URL set): a real Chrome is launched and supervised by
# docker/entrypoint.sh (with remote debugging on, see FACEBOOK_CDP_PORT
# there), and the bot only *attaches* to it -- this is what lets the noVNC
# view and the bot's automation look at the exact same window. Inside the
# Docker image built from this repo's Dockerfile, entrypoint.sh sets this for
# you; only override it if Chrome is supervised some other way.
# FACEBOOK_CDP_URL=http://127.0.0.1:9222
# FACEBOOK_DISPLAY_NUM=99                 # virtual display number, container-only

# --- Remote live view: Telegram button -> token-gated link -> noVNC -------
#
# When the session needs a human (first login, or a checkpoint), the admin
# gets a Telegram message with one "Open Facebook" button. It opens a
# private, short-lived, one-incident-only link straight to the live browser
# window -- no ssh, no VPN client, no terminal, nothing else to install.
#
# This works via the bot's own tiny proxy (bot/services/facebook/gate.py),
# which sits in front of noVNC and only lets a request through with a valid
# token. That proxy always runs on FACEBOOK_GATE_PORT (127.0.0.1 only) when
# FACEBOOK_ENABLED=true -- what makes the Telegram button actually reachable
# from outside is putting a Tailscale Funnel in front of that one port. See
# "Tailscale Funnel setup" just below for the one-time steps.
#
# A base any other device can open REQUIRES a PIN below -- the bot refuses
# to start without one. The token travels in a Telegram message, so on its
# own the link is the only thing between a forwarded chat and a browser
# logged into Facebook. A loopback base (localhost / 127.0.0.1) is exempt:
# nobody else can reach it, and that is the normal way to run locally.
# FACEBOOK_DESKTOP_PUBLIC_BASE=https://your-machine.your-tailnet.ts.net
FACEBOOK_DESKTOP_TOKEN_TTL_SECONDS=1800      # how long a link stays valid, seconds
# FACEBOOK_DESKTOP_PIN=1234               # required whenever PUBLIC_BASE is set
FACEBOOK_GATE_BIND_ADDRESS=127.0.0.1
FACEBOOK_GATE_PORT=8090
FACEBOOK_NOVNC_INTERNAL_URL=http://127.0.0.1:6080
FACEBOOK_TOKEN_STORE_PATH=./data/facebook_gate_token.json

# --- Tailscale Funnel setup (developer does this once per VM; the admin --
# --- using the Telegram button never touches any of this) -----------------
#
#   1. On the VM: install Tailscale and sign in.
#        curl -fsSL https://tailscale.com/install.sh | sh
#        tailscale up
#   2. Turn on Funnel for this tailnet once, from https://login.tailscale.com/admin/acls
#      (or `tailscale funnel` will print the exact ACL snippet to add if it's
#      not on yet).
#   3. Point Funnel at the gate's port (8090 -- NOT 6080, and NOT the Chrome
#      CDP port):
#        tailscale funnel --bg 8090
#      This prints the public HTTPS address, e.g.
#      https://your-machine.your-tailnet.ts.net -- put that in
#      FACEBOOK_DESKTOP_PUBLIC_BASE above (no trailing slash), set
#      FACEBOOK_DESKTOP_PIN, and restart the bot.
#   3b. Check the link actually works end to end before relying on it:
#        python scripts/gate_probe.py
#      It fakes noVNC and drives the gate the way a phone would, so a broken
#      viewer link shows up here rather than the first time a checkpoint
#      appears at an inconvenient moment.
#   4. That's it. From here on the admin only ever taps the Telegram button;
#      they never install Tailscale, never see a terminal, and never see the
#      *.ts.net address directly.
#
# `tailscale funnel status` shows what's currently funneled; `tailscale
# funnel --bg 8090` again re-asserts it if the VM rebooted (add it to your
# boot scripts / systemd unit rather than typing it after every reboot).
